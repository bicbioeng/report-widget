{
  "name": "@bicbioeng/report-widget",
  "version": "1.1.0",
  "description": "The KIDS in-app Report widget (bug / idea / question with screenshot, annotation, voice, screen recording and captured context) as a shared React package with pluggable transports.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "PAYLOAD.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/kids": {
      "import": {
        "types": "./dist/adapters/kids.d.ts",
        "default": "./dist/adapters/kids.js"
      },
      "require": {
        "types": "./dist/adapters/kids.d.cts",
        "default": "./dist/adapters/kids.cjs"
      }
    },
    "./adapters/reads-graphql": {
      "import": {
        "types": "./dist/adapters/reads-graphql.d.ts",
        "default": "./dist/adapters/reads-graphql.js"
      },
      "require": {
        "types": "./dist/adapters/reads-graphql.d.cts",
        "default": "./dist/adapters/reads-graphql.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:fixtures": "npm pack --pack-destination fixtures && node -e \"const fs=require('fs');const f=fs.readdirSync('fixtures').find(n=>n.endsWith('.tgz')&&n!=='report-widget.tgz');fs.renameSync('fixtures/'+f,'fixtures/report-widget.tgz')\""
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.3.0 || ^6.0.0",
    "antd": "^5.13.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@zumer/snapdom": "^2.24.15",
    "bowser": "^2.14.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/react": "^18.3.31",
    "antd": "^5.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bicbioeng/report-widget.git"
  }
}
